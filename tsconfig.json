{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite", "vite/client", "jest", "node"]
  },
  "include": ["src/**/*", "env.d.ts", "vite.config.ts", "electron/**/*", "tests/**/*"]
}
