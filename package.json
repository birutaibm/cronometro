{
  "name": "cronometro",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npx jest --config jest.config.js --forceExit",
    "test:coverage": "rm -rf coverage && npx jest --config jest.config.js --coverage --forceExit",
    "test:integration": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "build:main": "npx tsc --project tsconfig.main.json",
    "electron:dev": "npm run build:main && node scripts/start-electron.cjs",
    "electron:build": "npm run build:main && npm run build && electron-builder",
    "postinstall": "npx force-resolutions && electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electron/remote": "^2.1.4",
    "@playwright/electron": "^0.0.1",
    "electron": "^38.2.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "@types/vue": "^2.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.10",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.32.1",
    "vite-plugin-electron-renderer": "^0.5.0"
  }
}
