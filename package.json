{
  "name": "cronometro",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:main": "npx tsc --project tsconfig.main.json",
    "electron:dev": "npm run build:main && node scripts/start-electron.cjs",
    "electron:build": "npm run build:main && npm run build && electron-builder",
    "postinstall": "npx force-resolutions && electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "npm-force-resolutions": "^0.0.10",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.cronometro.app",
    "productName": "Cronometro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "resolutions": {
    "@noble/hashes": "1.4.0"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
