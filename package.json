{
  "name": "cronometro",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npx jest --config jest.config.js --forceExit",
    "test:coverage": "rm -rf coverage && npx jest --config jest.config.js --coverage --forceExit",
    "test:integration": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "build:main": "npx tsc --project tsconfig.main.json",
    "electron:dev": "npm run build:main && node scripts/start-electron.cjs",
    "electron:build": "npm run build:main && npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"electron/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@playwright/electron": "^0.0.1",
    "electron": "^38.2.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/vue": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
